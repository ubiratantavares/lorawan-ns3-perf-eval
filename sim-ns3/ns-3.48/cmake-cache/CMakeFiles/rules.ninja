#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/bira/tools/cmake-3.31.12-linux-x86_64/bin/cmake --regenerate-during-build -S/home/bira/github/projetos/lorawan-ns3-perf-eval/sim-ns3/ns-3.48 -B/home/bira/github/projetos/lorawan-ns3-perf-eval/sim-ns3/ns-3.48/cmake-cache
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for re-checking globbed directories.

rule VERIFY_GLOBS
  command = /home/bira/tools/cmake-3.31.12-linux-x86_64/bin/cmake -P /home/bira/github/projetos/lorawan-ns3-perf-eval/sim-ns3/ns-3.48/cmake-cache/CMakeFiles/VerifyGlobs.cmake
  description = Re-checking globbed directories...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /usr/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /usr/bin/ninja -t targets
  description = All primary targets available:

